# 最小本地启动骨架
TS_CORE_BOT_ID=local-bot

# PostgreSQL（关系型数据库） 连接描述样例
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ts_core
PG_USER=ts_core
PG_PASSWORD=ts_core_dev_password
PG_POOL_MIN=2
PG_POOL_MAX=10

# Redis（缓存） 连接描述样例
REDIS_URL=redis://localhost:6379

# 日志与数据保留期样例
LOGS_BASE_DIR=./logs
EVENT_LOG_RETENTION_DAYS=30
TASK_LOG_RETENTION_DAYS=90
LLM_LOG_RETENTION_DAYS=30
SANDBOX_LOG_RETENTION_DAYS=7
EMBEDDING_DIMENSIONS=1024

# Minecraft（我的世界） 连接与外部认证
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=local-bot
MC_VERSION=
MC_AUTH=
# worldName（世界名）=dimension type（维度类型）；短名会匹配 multiworld:<短名>。
MC_WORLD_DIMENSION_MAP=cherry=minecraft:overworld,minecraft:overworld=minecraft:overworld,minecraft:the_end=minecraft:the_end,minecraft:the_nether=minecraft:the_nether,resource=minecraft:overworld
MC_EXTERNAL_AUTH_REQUIRED=false
MC_EXTERNAL_AUTH_ENTRYPOINT=game_chat_command
MC_EXTERNAL_AUTH_SECRET=

# OpenAI（开放人工智能） 兼容 LLM（大语言模型） 最短闲聊链路
LLM_BASE_URL=http://127.0.0.1:8045/v1
LLM_API_KEY=sk-local-dev
LLM_MODEL=bl-auto

# Server Bridge（服务端桥接） 接入配置
SERVER_BRIDGE_ACCESS_TOKEN=
SERVER_BRIDGE_PATH=/ws/server-bridge
SERVER_BRIDGE_HEARTBEAT_TIMEOUT_MS=90000
SERVER_BRIDGE_CONVERSATION_ENABLED=false

{
  "name": "ts-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check package.json tsconfig.json biome.json drizzle.config.ts vitest.config.ts README.md src",
    "format": "biome format --write package.json tsconfig.json biome.json drizzle.config.ts vitest.config.ts README.md src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3"
  }
}
